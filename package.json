{
  "name": "tupu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc -b",
    "effect:check": "node scripts/effect-check.ts",
    "fmt": "oxfmt --check .",
    "fmt:write": "oxfmt --write .",
    "check": "pnpm test && pnpm lint && pnpm typecheck && pnpm effect:check && pnpm fmt",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "deploy": "alchemy deploy --stage prod",
    "destroy": "alchemy destroy --stage prod",
    "cf:login": "alchemy profile edit --add Cloudflare",
    "build:server": "vite build -c vite.server.config.ts",
    "serve": "node server/main.ts",
    "start": "node dist-server/server.mjs"
  },
  "dependencies": {
    "@effect/platform-browser": "4.1.2",
    "@effect/platform-node": "4.1.2",
    "@effect/sql-sqlite-wasm": "4.1.2",
    "@effect/wa-sqlite": "0.1.2",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tanstack/charts": "1.5.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-hotkeys": "0.22.3",
    "@tanstack/react-pacer": "0.24.1",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-store": "0.11.2",
    "@tanstack/react-table": "9.3.1",
    "effect": "4.1.2",
    "kysely": "0.29.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "scheduler": "0.28.0"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@effect/sql-sqlite-node": "4.1.2",
    "@effect/tsgo": "0.67.5",
    "@effect/vitest": "4.1.2",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query-devtools": "5.107.1",
    "@tanstack/react-router-devtools": "1.167.3",
    "@tanstack/router-plugin": "1.169.0",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "alchemy": "2.0.0-beta.85",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=12.15.0"
  },
  "packageManager": "pnpm@12.15.0"
}
